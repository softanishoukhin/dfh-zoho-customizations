catch (e)
{
	info e;
}
paymentID = customer_payment.get("payment_id");
organizationID = organization.get("organization_id");
currencyInfo = invokeurl
[
	url :"https://www.zohoapis.com/books/v3/settings/incomingwebhooks/iw_getpaymentcurrencycode/execute?auth_type=apikey&encapiKey=<BOOKS_WEBHOOK_ENCAPIKEY>&payment_id=" + paymentID
	type :GET
];
try
{
	currencyCode = currencyInfo.get("response").get("currencyCode");
	//currencyCode = customer_payment.get("currency_code");
}
catch (e)
{
	currencyCode = "JMD";
}
//info currencyInfo.get("response").get("currencyCode");
//info customer_payment;
//info customer_payment;
//records = zoho.people.getRecordByID("Candidate",peopleID);
document_id = "pd9n48147104968594137ae1cab04506567d5";
email = null;
data = Map();
data.put("receipt_no",customer_payment.get("payment_number"));
if(customer_payment.get("custom_field_hash").containKey("cf_actual_paid_amount"))
{
	data.put("amount",currencyCode + " " + customer_payment.get("custom_field_hash").get("cf_actual_paid_amount"));
}
else
{
	data.put("amount",currencyCode + " " + customer_payment.get("amount").toString());
}
data.put("date",customer_payment.get("date").toString("MM-dd-yyyy"));
data.put("payment_method",ifnull(customer_payment.get("payment_mode"),""));
//info data;
booksInvoiceId = customer_payment.get("invoices").get(0).get("invoice_id");
booksInvoiceDetailsData = zoho.books.getRecordsByID("invoices",organizationID,booksInvoiceId,"zohobooksconnection");
booksInvoiceDetails = booksInvoiceDetailsData.get("invoice");
deceasedName = "";
if(booksInvoiceDetails.get("custom_field_hash").containKey("cf_crm_invoice_id"))
{
	crmInvoiceDetails = zoho.crm.getRecordById("Invoices",booksInvoiceDetails.get("custom_field_hash").get("cf_crm_invoice_id"));
	deceasedName = crmInvoiceDetails.get("Deal_Name__s").get("name");
}
else if(booksInvoiceDetails.containKey("customer_name"))
{
	deceasedName = booksInvoiceDetails.get("customer_name");
}
info "deceasedName" + deceasedName;
//deceasedName = customer_payment.get("customer_name");
info "customer_payment custom_field_hash" + customer_payment.get("custom_field_hash");
data.put("Deal_Name__s.Deal_Name",deceasedName);
if(customer_payment.get("custom_field_hash").containKey("cf_payer_unformatted"))
{
	payerCRMContactID = customer_payment.get("custom_field_hash").get("cf_payer_unformatted");
	payerDetails = zoho.crm.getRecordById("Contacts",payerCRMContactID);
	if(!isNull(payerDetails.get("Email")))
	{
		email = payerDetails.get("Email");
	}
	data.put("contact",ifnull(payerDetails.get("Mobile"),""));
	data.put("name",ifnull(payerDetails.get("First_Name"),"") + ' ' + ifnull(payerDetails.get("Last_Name"),""));
}
else if(customer_payment.get("custom_field_hash").containKey("cf_new_payer_name_if_not_found"))
{
	newPayerName = customer_payment.get("custom_field_hash").get("cf_new_payer_name_if_not_found");
	if(customer_payment.get("custom_field_hash").containKey("cf_new_payer_contact"))
	{
		data.put("contact",customer_payment.get("custom_field_hash").get("cf_new_payer_contact"));
	}
	data.put("name",newPayerName);
}
// paramMap = {"send_from_org_email_id":true,"to_mail_ids":{email},"subject":"Statement of transactions with DFH","body":"Dear Customer,     <br/>We have attached with this email a list of all your transactions with us for this month. You can write to us or call us if you need any assistance or clarifications.     <br/>Thanks & Regards.<br/>Regards<br/>DFH"};
