output_settings = Map();
output_settings.put("doc_name","Payment Receipt");
document_info = zoho.writer.mergeAndStore(document_id,data,output_settings,"writer_connection");
//info document_info;
document_id = document_info.get("document_id");
//document_url = document_info.get("document_url");
document_details = invokeurl
[
	url :"https://zohoapis.com/writer/api/v1/documents/" + document_id
	type :GET
	connection:"writer_connection"
];
download_url = document_details.get("download_url");
download = invokeurl
[
	url :"https://zohoapis.com/writer/api/v1/documents/" + document_id + "?format=pdf"
	type :GET
	connection:"writer_connection"
];
responseToUploadInWD = zoho.workdrive.uploadFile(download,"298em38e4a3da4c154189b406b15fb9b2b17f","Payment Receipt - " + customer_payment.get("payment_number") + ".pdf",false,"wdconnection");
//info responseToUploadInWD;
workdriveFileID = responseToUploadInWD.get("data").get(0).get("attributes").get("resource_id");
header = Map();
header.put("Accept","application/vnd.api+json");
dataPermission = Map();
data_param1 = Map();
att_param1 = Map();
att_param1.put("resource_id",workdriveFileID);
att_param1.put("shared_type","everyone");
att_param1.put("role_id","34");
data_param1.put("attributes",att_param1);
data_param1.put("type","permissions");
dataPermission.put("data",data_param1);
responsePermission = invokeurl
[
	url :"https://www.zohoapis.com/workdrive/api/v1/permissions"
	type :POST
	parameters:dataPermission.toString()
	headers:header
	connection:"wdconnection"
];
info responsePermission;
paymentRecordMap = Map();
customFieldsList = list();
fieldMap = Map();
fieldMap.put("api_name","cf_download_payment_receipt");
fieldMap.put("value",responseToUploadInWD.get("data").get(0).get("attributes").get("Permalink"));
customFieldsList.add(fieldMap);
paymentRecordMap.put("custom_fields",customFieldsList);
updatePayment = zoho.books.updateRecord("customerpayments",organizationID,paymentID,paymentRecordMap,"zohobooksconnection");
customFields = booksInvoiceDetails.get("custom_field_hash");
isEcommerce = false;
if(customFields.containKey("cf_is_ecommerce"))
{
	isEcommerceValue = customFields.get("cf_is_ecommerce");
	isEcommerce = isEcommerceValue.toString().equalsIgnoreCase("true");
}
sendEmailToClient = !isEcommerce;
if(isNull(email))
{
	if(customer_payment.get("custom_field_hash").containKey("cf_new_payer_email"))
	{
		emailNew = customer_payment.get("custom_field_hash").get("cf_new_payer_email");
		if(sendEmailToClient)
		{
			sendmail
			[
				from :zoho.loginuserid
				to :emailNew
				subject :"DFH - Payment Receipt"
				message :"Please check your attached payment receipt."
				Attachments :file:download
			]
		}
	}
	else
	{
		booksCustomerDetails = zoho.books.getRecordsByID("contacts",organizationID,customer_payment.get("customer_id"),"zohobooksconnection");
		email = booksCustomerDetails.get("contact").get("email");
		payerCRMContactID = booksCustomerDetails.get("contact").get("zcrm_contact_id");
	}
}
if(!isNull(email) && sendEmailToClient)
{
	download.setParamName("file");
	response = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v2.1/files"
		type :POST
		files:download
		connection:"zohocrmconnection"
	];
	fid = response.get("data").get(0).get("details").get("id");
	info fid;
	sendfrom = Map();
	sendfrom.put("email",zoho.crm.getOrgVariable("globalFromEmail"));
	sendto = Map();
	sendto.put("email",email);
	tolist = List();
	tolist.add(sendto);
	// replyToAddress = Map();
	// replyToAddress.put("email",dealInfo.get("Owner").get("email"));
	mp = Map();
	mp.put("from",sendfrom);
	// mp.put("reply_to",replyToAddress);
	mp.put("to",tolist);
	mp.put("org_email",true);
	mp.put("attachments",{{"id":fid}});
	mp.put("template",{"id":"6503357000018064015"});
	dlist = List();
	dlist.add(mp);
	data = Map();
	data.put("data",dlist);
	sendmail = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v2.1/Contacts/" + payerCRMContactID + "/actions/send_mail"
		type :POST
		parameters:data + ""
		connection:"zohocrmconnection"
	];
	//  info sendmail;
}
