// Task: ZP-TBD-63 v2 -- supersedes saveAssignment_FIX.deluge in this same folder.
// Zoho App: Creator (Trip_Manager.ds)
// Function Name: map saveAssignment(...) -- EXISTING, fix only.
//
// WHY v2, NOT just a patch on v1: v1 added "Deal" to the REST PUT payload so the live
// "Prevent Edit Vehicle" CRM validation rule (preventeditvehicle) could see it and run its
// own double-booking check + Vehicle_Bookings creation. User reported it still wasn't
// working after deploying v1. Rather than keep chasing why that specific CRM function
// call from inside a REST PUT does or doesn't behave as expected, and given the user
// explicitly asked for Trip Manager's OWN save to "validate like the CRM function" --
// this version makes saveAssignment fully self-contained: it does its own double-booking
// check (same query shape as the already-working getAvailableHearses function in this
// same file), returns its own clear rejection message, and creates/updates the
// Vehicle_Bookings record itself on success. It does NOT send "Deal" in the payload
// anymore -- if it did, the CRM validation rule would ALSO fire (now that Deal is
// present) and could create a SECOND, duplicate Vehicle_Bookings record for the same
// assignment. Keeping this function as the single, exclusive owner of that logic avoids
// that risk entirely.
//
// THREE CHANGES IN THIS VERSION, per direct request:
// 1. Departure time is now MANDATORY whenever any vehicle (hearse, removal, or rental) is
//    selected -- previously optional, only affecting whether the trip became "Scheduled".
//    Now the save is rejected outright with a clear message if missing.
// 2. Before saving, if the selected Hearse is a specific, Availability_Based fleet
//    vehicle (not the generic non-Availability_Based "Hearse" line item -- same
//    distinction already used everywhere else in this app, e.g. getTripDetail's
//    hearse_locked rule), check Vehicle_Bookings directly for a same-day conflict
//    (excluding this trip's own existing booking). If found, reject with "This vehicle
//    is already booked on this day." and do not save at all.
// 3. On a successful save of such a vehicle, create (or update, if this trip already had
//    one) the Vehicle_Bookings record directly, and stamp its id back onto the Trip's
//    Vehicle_Booking_ID field -- exactly mirroring what the CRM validation rule already
//    does for a direct CRM UI edit, so getAvailableHearses (and therefore the "only show
//    available vehicles" dropdown behavior, which already existed and just had no real
//    booking data to filter against) now has real data to work with.
//
// OUT OF SCOPE (not attempted here, flag if it becomes a problem): if a trip's vehicle is
// changed from one Availability_Based vehicle to a different one, the OLD Vehicle_Bookings
// record for the previous vehicle is not actively released/deleted -- same gap as existed
// in the CRM validation rule's own original logic. Not fixed here to keep this change
// scoped to what was asked; flag separately if stale bookings become an issue.

map saveAssignment(string tripId, string hearseId, string removalId, string rentalId, string driverId, string attendantId, string departureTime)
{
	result = Map();
	result.put("success",false);
	result.put("message","");
	result.put("scheduled",false);
	result.put("missing",List());
	try
	{
		// NEW 1: departure time mandatory whenever any vehicle is selected.
		anyVehicleSelected = (hearseId != "" || removalId != "" || rentalId != "");
		if(anyVehicleSelected && departureTime == "")
		{
			result.put("message","Please set a departure time before saving a vehicle assignment.");
			return result;
		}
		updMap = Map();
		if(hearseId != "")
		{
			updMap.put("Vehicle",hearseId.toLong());
		}
		if(removalId != "")
		{
			updMap.put("Amber_Vehicle",removalId.toLong());
		}
		if(rentalId != "")
		{
			updMap.put("Rental_Vehicles",rentalId.toLong());
		}
		if(driverId != "")
		{
			updMap.put("Driver",driverId.toLong());
		}
		if(attendantId != "")
		{
			updMap.put("Attendant_NEW",attendantId.toLong());
		}
		depFormatted = "";
		if(departureTime != "")
		{
			depClean = departureTime.trim();
			try
			{
				depDt = depClean.toDateTime("yyyy-MM-dd HH:mm");
				depFormatted = depDt.toString("yyyy-MM-dd'T'HH:mm:ss");
			}			catch (e2)
			{
				depFormatted = "";
			}
			if(depFormatted != "")
			{
				updMap.put("Departure_Time",depFormatted);
				updMap.put("Scheduled_Date",depFormatted);
				updMap.put("Funeral_Time_Change_Alert",false);
				updMap.put("Grave_Type_Change_Alert",false);
			}
			else
			{
				result.put("message","Invalid departure date/time format");
				return result;
			}
		}
		hasVehicle = anyVehicleSelected;
		hasDriver = driverId != "";
		hasDeparture = departureTime != "";
		isSchedulable = hasVehicle && hasDriver && hasDeparture;
		missingItems = List();
		if(!hasVehicle)
		{
			missingItems.add("a vehicle");
		}
		if(!hasDriver)
		{
			missingItems.add("a driver");
		}
		if(!hasDeparture)
		{
			missingItems.add("a departure time");
		}
		result.put("missing",missingItems);
		// Fetch the current Trip whenever we need Trip_Status (isSchedulable) or its
		// existing Vehicle_Booking_ID (whenever a hearse is being assigned).
		currentTrip = Map();
		if(isSchedulable || hearseId != "")
		{
			try
			{
				currentTrip = zoho.crm.getRecordById("Trips",tripId.toLong(),{"connection":"zohocrm_connection"});
			}			catch (eCur)
			{
				currentTrip = Map();
			}
		}
		currentStatus = "";
		if(isSchedulable && currentTrip.containKey("id"))
		{
			tsRaw = currentTrip.get("Trip_Status");
			if(!isNull(tsRaw))
			{
				currentStatus = "" + tsRaw;
			}
		}
		existingBookingId = "";
		if(currentTrip.containKey("id"))
		{
			ebRaw = currentTrip.get("Vehicle_Booking_ID");
			if(!isNull(ebRaw))
			{
				existingBookingId = "" + ebRaw;
			}
		}
		dealIdForBooking = "";
		if(currentTrip.containKey("id"))
		{
			try
			{
				dealLk = currentTrip.get("Deal");
				didRaw = "" + dealLk.get("id");
				if(didRaw != "" && didRaw != "null")
				{
					dealIdForBooking = didRaw;
				}
			}			catch (eDealLk)
			{
			}
		}
		// NEW 2 + 3 setup: is the selected Hearse a specific, Availability_Based fleet
		// vehicle? Only those are booking-tracked (matches hearse_locked's own rule
		// elsewhere in this file -- a generic "Hearse" line item is never booking-locked).
		newBookingVehicleId = "";
		hearseProduct = Map();
		if(hearseId != "")
		{
			try
			{
				hearseProduct = zoho.crm.getRecordById("Products",hearseId.toLong(),{"connection":"zohocrm_connection"});
				abRaw = hearseProduct.get("Availability_Based");
				abStr = "" + abRaw;
				if(abStr == "true")
				{
					newBookingVehicleId = hearseId;
				}
			}			catch (eProd)
			{
			}
		}
		// NEW 2: same-day double-booking check, same query shape as getAvailableHearses.
		if(newBookingVehicleId != "")
		{
			depDatePrefix = depFormatted;
			if(depDatePrefix.length() > 10)
			{
				depDatePrefix = depDatePrefix.subString(0,10);
			}
			conflictFound = false;
			try
			{
				bq = Map();
				bq.put("select_query","select id, Deal, Vehicle, Start from Vehicle_Bookings where ((Vehicle in (" + newBookingVehicleId + ")) and (Status in ('Confirmed','Tentative')) and (Start between '" + depDatePrefix + "T00:00:00-05:00' and '" + depDatePrefix + "T23:59:59-05:00')) limit 200");
				bresp = invokeurl
				[
					url :"https://www.zohoapis.com/crm/v7/coql"
					type :POST
					parameters:bq.toString()
					headers:{"Content-Type":"application/json"}
					connection:"zoho_oauth_connection"
				];
				if(bresp.containKey("data"))
				{
					for each  br in bresp.get("data")
					{
						brId = "" + br.get("id");
						if(brId != "" && brId != existingBookingId)
						{
							conflictFound = true;
						}
					}
				}
			}			catch (eBq)
			{
			}
			if(conflictFound)
			{
				result.put("message","This vehicle is already booked on this day.");
				return result;
			}
		}
		willSetScheduled = false;
		if(isSchedulable && currentStatus != "Started" && currentStatus != "Completed")
		{
			updMap.put("Trip_Status","Scheduled");
			willSetScheduled = true;
		}
		if(updMap.isEmpty())
		{
			result.put("message","No fields to update");
			return result;
		}
		// ===== REST PUT (unchanged mechanism from ZP-TBD-25) — goes through the real API
		// save pipeline so other validation/workflow rules on Trips still run normally.
		// "Deal" is intentionally NOT included here (see header note) -- this function now
		// owns the double-booking check and Vehicle_Bookings creation itself. =====
		putDataList = List();
		putDataList.add(updMap);
		putTrigger = List();
		putTrigger.add("workflow");
		putBody = Map();
		putBody.put("data",putDataList);
		putBody.put("trigger",putTrigger);
		exceptionMessage = "";
		putCode = "";
		putMessage = "";
		try
		{
			putResp = invokeurl
			[
				url :"https://www.zohoapis.com/crm/v7/Trips/" + tripId
				type :PUT
				parameters:putBody.toString()
				headers:{"Content-Type":"application/json"}
				connection:"zohocrm_connection"
			];
			try
			{
				putData = putResp.get("data");
				putFirst = putData.get(0);
				putCode = ifnull(putFirst.get("code"),"");
				putMessage = ifnull(putFirst.get("message"),"");
			}			catch (ePutParse)
			{
			}
			if(putCode != "SUCCESS")
			{
				if(putMessage != "")
				{
					exceptionMessage = putMessage;
				}
				else
				{
					exceptionMessage = "Trip update did not return SUCCESS: " + putResp.toString();
				}
			}
		}		catch (e)
		{
			exceptionMessage = e.toString();
		}
		if(exceptionMessage != "")
		{
			result.put("message",exceptionMessage);
			return result;
		}
		// NEW 3: create/update the Vehicle_Bookings record ourselves now that the save
		// succeeded -- exclusive owner of this, see header note on why "Deal" is not sent
		// above (avoids the CRM validation rule also creating a duplicate).
		if(newBookingVehicleId != "" && dealIdForBooking != "")
		{
			try
			{
				vbMap = Map();
				vbNameLabel = ifnull(hearseProduct.get("Product_Name"),"Vehicle") + " " + depFormatted;
				vbMap.put("Name",vbNameLabel);
				vbMap.put("Vehicle",newBookingVehicleId.toLong());
				vbMap.put("Deal",dealIdForBooking.toLong());
				vbMap.put("Start",depFormatted);
				vbMap.put("End",depFormatted);
				vbMap.put("Status","Confirmed");
				vbMap.put("Calendar_View_enabled",true);
				vbMap.put("Note",vbNameLabel);
				if(existingBookingId != "")
				{
					zoho.crm.updateRecord("Vehicle_Bookings",existingBookingId.toLong(),vbMap,{"connection":"zohocrm_connection"});
				}
				else
				{
					vbResult = zoho.crm.createRecord("Vehicle_Bookings",vbMap,{"connection":"zohocrm_connection"});
					newVbId = "";
					try
					{
						newVbId = "" + vbResult.get("id");
					}					catch (eVbId)
					{
						newVbId = "";
					}
					if(newVbId != "" && newVbId != "null")
					{
						tripStamp = Map();
						tripStamp.put("Vehicle_Booking_ID",newVbId);
						zoho.crm.updateRecord("Trips",tripId.toLong(),tripStamp,{"connection":"zohocrm_connection"});
					}
				}
			}			catch (eVb)
			{
			}
		}
		result.put("success",true);
		result.put("message","Assignment saved");
		result.put("scheduled",willSetScheduled);
	}	catch (e)
	{
		result.put("message","Exception: " + e);
	}
	return result;
}
