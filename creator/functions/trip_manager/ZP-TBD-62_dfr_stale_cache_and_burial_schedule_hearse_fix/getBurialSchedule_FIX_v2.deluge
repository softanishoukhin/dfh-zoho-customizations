// Task: ZP-TBD-62, part 2 -- corrects the ZP-TBD-24 part 2 guideline, which was deployed
// but had two bugs of its own (see metadata.md in this folder for the full live-debugged
// root cause of each). This is the complete, corrected function.
// Zoho App: Creator (Trip_Manager.ds)
// Function Name: list getBurialSchedule(String fromDate, String toDate) -- EXISTING, fix only.

list getBurialSchedule(String fromDate, String toDate)
{
	result = List();
	fromD = ifnull(fromDate,"").trim();
	toD = ifnull(toDate,"").trim();
	if(fromD == "" || toD == "")
	{
		return result;
	}
	fromDT = fromD + "T00:00:00-05:00";
	toDT = toD + "T23:59:59-05:00";
	deals = List();
	try
	{
		dq = Map();
		dq.put("select_query","select id, Name_of_Deceased, Casket_Type, Church_Chapel, Place_of_Internment, Hearse, Funeral_Time from Deals where Funeral_Time between '" + fromDT + "' and '" + toDT + "' order by Funeral_Time asc limit 200");
		dresp = invokeurl
		[
			url :"https://www.zohoapis.com/crm/v7/coql"
			type :POST
			parameters:dq.toString()
			headers:{"Content-Type":"application/json"}
			connection:"zoho_oauth_connection"
		];
		if(dresp.containKey("data"))
		{
			deals = dresp.get("data");
		}
	}	catch (eDeals)
	{
	}
	if(deals.isEmpty())
	{
		return result;
	}
	idList = List();
	for each  d in deals
	{
		idList.add("" + d.get("id"));
	}
	depByDeal = Map();
	// TM-assigned vehicle name per Deal, fallback source for the Hearse column.
	vehByDeal = Map();
	batch = "";
	batchCount = 0;
	idx = 0;
	total = idList.size();
	for each  did in idList
	{
		if(batch == "")
		{
			batch = did;
		}
		else
		{
			batch = batch + "," + did;
		}
		batchCount = batchCount + 1;
		idx = idx + 1;
		if(batchCount == 50 || idx == total)
		{
			try
			{
				tq = Map();
				// Also select Vehicle / Amber_Vehicle / Rental_Vehicles alongside
				// Departure_Time, so the manually-assigned vehicle is available as a fallback.
				// NOTE: the WHERE clause below MUST be bracket-grouped -- a flat
				// "Deal in (...) and Trip_Type = 'Funeral'" throws in COQL and gets
				// silently swallowed by the catch below (Bug A, see metadata.md).
				tq.put("select_query","select id, Deal, Departure_Time, Vehicle, Amber_Vehicle, Rental_Vehicles from Trips where (Deal in (" + batch + ") and Trip_Type = 'Funeral') limit 200");
				tresp = invokeurl
				[
					url :"https://www.zohoapis.com/crm/v7/coql"
					type :POST
					parameters:tq.toString()
					headers:{"Content-Type":"application/json"}
					connection:"zoho_oauth_connection"
				];
				if(tresp.containKey("data"))
				{
					for each  tr in tresp.get("data")
					{
						dep = ifnull(tr.get("Departure_Time"),"");
						dlk = tr.get("Deal");
						tdid = "";
						try
						{
							tdid = "" + dlk.get("id");
						}						catch (eLk)
						{
							tdid = "" + dlk;
						}
						if(tdid != "" && tdid != "null")
						{
							if(dep != "")
							{
								depByDeal.put(tdid,dep);
							}
							// Resolve whichever vehicle lookup is populated, in this priority
							// order -- Vehicle (removal/company vehicle), then Amber_Vehicle
							// (removal vehicle booked via Amber), then Rental_Vehicles.
							// NOTE: isNull() does not reliably return a boolean on a Map that
							// came from an invokeurl/COQL JSON response (confirmed live -- it
							// returned the value null instead of false, so "!isNull(...)"
							// never took the true branch and vehName was silently always ""
							// even when Vehicle genuinely had a value -- Bug B, see
							// metadata.md). Read directly and let the try/catch handle a
							// genuine null instead -- proved live to work correctly both ways.
							vehName = "";
							try
							{
								vehName = ifnull(tr.get("Vehicle").get("name"),"");
							}							catch (eV)
							{
								vehName = "";
							}
							if(vehName == "")
							{
								try
								{
									vehName = ifnull(tr.get("Amber_Vehicle").get("name"),"");
								}								catch (eAV)
								{
									vehName = "";
								}
							}
							if(vehName == "")
							{
								try
								{
									vehName = ifnull(tr.get("Rental_Vehicles").get("name"),"");
								}								catch (eRV)
								{
									vehName = "";
								}
							}
							if(vehName != "")
							{
								vehByDeal.put(tdid,vehName);
							}
						}
					}
				}
			}			catch (eTrips)
			{
			}
			batch = "";
			batchCount = 0;
		}
	}
	for each  d in deals
	{
		did = "" + d.get("id");
		row = Map();
		row.put("dealId",did);
		row.put("deceasedName",ifnull(d.get("Name_of_Deceased"),""));
		row.put("casketType",ifnull(d.get("Casket_Type"),""));
		row.put("church",ifnull(d.get("Church_Chapel"),""));
		row.put("internment",ifnull(d.get("Place_of_Internment"),""));
		// Fall back to the TM-assigned vehicle (from the Funeral trip) when the
		// invoice-booked Hearse picklist is empty.
		hearseVal = ifnull(d.get("Hearse"),"");
		if(hearseVal == "")
		{
			hearseVal = ifnull(vehByDeal.get(did),"");
		}
		row.put("hearse",hearseVal);
		row.put("funeralTime",ifnull(d.get("Funeral_Time"),""));
		row.put("departureTime",ifnull(depByDeal.get(did),""));
		result.add(row);
	}
	return result;
}
