// Task: ZP-TBD-25 -- Trip Manager vehicle assignment doesn't trigger "Prevent Edit Vehicle"
// Zoho App: Creator (Trip_Manager.ds)
// Function Name: map saveAssignment(...) -- EXISTING, this is a fix, not new.
// Reported by: user, 2026-08-18: editing Hearse Vehicles directly on a Trip in CRM fires the
//              "Prevent Edit Vehicle" Validation Rule (which also creates/updates the matching
//              Vehicle_Bookings record), but assigning the same field through Trip Manager does
//              not.
//
// ROOT CAUSE (confirmed live): CRM has a genuine Validation Rule on Trips.Vehicle ("Prevent Edit
// Vehicle", function preventEditVehicle) -- not a workflow rule. Validation Rules are only
// enforced by Zoho's actual REST API / UI save pipeline. Deluge's built-in
// zoho.crm.updateRecord(...) task -- even with {"trigger":{"workflow"}} -- does NOT go through
// that pipeline for validation rules; that trigger option only opts specific WORKFLOW rules in,
// it has no effect on validation rules at all. saveAssignment's vehicle write
// (Trip_Manager.ds ~3254) uses exactly that Deluge task, so the validation rule -- and its
// Vehicle_Bookings sync side effect -- never runs when TM assigns a vehicle.
//
// This is the same category of gap already fixed elsewhere in this codebase (Driver_App.ds's
// startJob/acceptTrip -- see their own header comments: "CRM update via a WORKFLOW-FIRING REST
// PUT ... none of them ran while this used the plain ... zoho.crm.updateRecord call"). Same fix
// here: replace the Deluge updateRecord call with a raw REST PUT via invokeurl, which goes
// through the real API pipeline and enforces Validation Rules, so "Prevent Edit Vehicle" (and
// its Vehicle_Bookings sync) fires correctly.
//
// ADDITIONAL BEHAVIOR CHANGE: preventEditVehicle can genuinely REJECT the save (e.g. "This
// vehicle is already booked on this day.", or "This vehicle cannot be edited because it was
// generated from the Deal product selection process."). Previously TM never saw this because the
// validation rule never ran. Now that it does, saveAssignment parses the REST response and
// surfaces that exact rejection message back to the UI instead of a generic failure, so TM staff
// see the real reason instead of just "assignment failed."
//
// Only the vehicle-write block changes below (search for "REST PUT" in the diff below) -- every
// other part of saveAssignment (missing-item checks, Trip_Status logic, etc.) is unchanged.

map saveAssignment(string tripId, string hearseId, string removalId, string rentalId, string driverId, string attendantId, string departureTime)
{
	result = Map();
	result.put("success",false);
	result.put("message","");
	result.put("scheduled",false);
	result.put("missing",List());
	try
	{
		updMap = Map();
		if(hearseId != "")
		{
			updMap.put("Vehicle",hearseId.toLong());
		}
		if(removalId != "")
		{
			updMap.put("Amber_Vehicle",removalId.toLong());
		}
		if(rentalId != "")
		{
			updMap.put("Rental_Vehicles",rentalId.toLong());
		}
		if(driverId != "")
		{
			updMap.put("Driver",driverId.toLong());
		}
		if(attendantId != "")
		{
			updMap.put("Attendant_NEW",attendantId.toLong());
		}
		if(departureTime != "")
		{
			depClean = departureTime.trim();
			depFormatted = "";
			try
			{
				depDt = depClean.toDateTime("yyyy-MM-dd HH:mm");
				depFormatted = depDt.toString("yyyy-MM-dd'T'HH:mm:ss");
			}			catch (e2)
			{
				depFormatted = "";
			}
			if(depFormatted != "")
			{
				updMap.put("Departure_Time",depFormatted);
				updMap.put("Scheduled_Date",depFormatted);
				updMap.put("Funeral_Time_Change_Alert",false);
				updMap.put("Grave_Type_Change_Alert",false);
			}
			else
			{
				result.put("message","Invalid departure date/time format");
				return result;
			}
		}
		hasVehicle = hearseId != "" || removalId != "" || rentalId != "";
		hasDriver = driverId != "";
		hasDeparture = departureTime != "";
		isSchedulable = hasVehicle && hasDriver && hasDeparture;
		missingItems = List();
		if(!hasVehicle)
		{
			missingItems.add("a vehicle");
		}
		if(!hasDriver)
		{
			missingItems.add("a driver");
		}
		if(!hasDeparture)
		{
			missingItems.add("a departure time");
		}
		result.put("missing",missingItems);
		currentStatus = "";
		if(isSchedulable)
		{
			try
			{
				currentTrip = zoho.crm.getRecordById("Trips",tripId.toLong(),{"connection":"zohocrm_connection"});
				if(currentTrip.containKey("id"))
				{
					tsRaw = currentTrip.get("Trip_Status");
					if(!isNull(tsRaw))
					{
						currentStatus = "" + tsRaw;
					}
				}
			}			catch (eStatus)
			{
				currentStatus = "";
			}
		}
		willSetScheduled = false;
		if(isSchedulable && currentStatus != "Started" && currentStatus != "Completed")
		{
			updMap.put("Trip_Status","Scheduled");
			willSetScheduled = true;
		}
		if(updMap.isEmpty())
		{
			result.put("message","No fields to update");
			return result;
		}
		// ===== REST PUT (was: zoho.crm.updateRecord) — goes through the real API save
		// pipeline so the "Prevent Edit Vehicle" Validation Rule (and any other validation
		// rule on Trips) actually runs, same as a direct CRM UI edit. =====
		putDataList = List();
		putDataList.add(updMap);
		putTrigger = List();
		putTrigger.add("workflow");
		putBody = Map();
		putBody.put("data",putDataList);
		putBody.put("trigger",putTrigger);
		exceptionMessage = "";
		putCode = "";
		putMessage = "";
		try
		{
			putResp = invokeurl
			[
				url :"https://www.zohoapis.com/crm/v7/Trips/" + tripId
				type :PUT
				parameters:putBody.toString()
				headers:{"Content-Type":"application/json"}
				connection:"zohocrm_connection"
			];
			try
			{
				putData = putResp.get("data");
				putFirst = putData.get(0);
				putCode = ifnull(putFirst.get("code"),"");
				putMessage = ifnull(putFirst.get("message"),"");
			}			catch (ePutParse)
			{
			}
			if(putCode != "SUCCESS")
			{
				exceptionMessage = putMessage != "" ? putMessage : ("Trip update did not return SUCCESS: " + putResp.toString());
			}
		}		catch (e)
		{
			exceptionMessage = e.toString();
		}
		if(exceptionMessage != "")
		{
			// Surface the real rejection reason (e.g. a Validation Rule block) to the UI
			// instead of a generic failure -- this is new: previously the validation rule
			// never ran from here, so this branch was unreachable for that case.
			result.put("message",exceptionMessage);
			return result;
		}
		result.put("success",true);
		result.put("message","Assignment saved");
		result.put("scheduled",willSetScheduled);
	}	catch (e)
	{
		result.put("message","Exception: " + e);
	}
	return result;
}
