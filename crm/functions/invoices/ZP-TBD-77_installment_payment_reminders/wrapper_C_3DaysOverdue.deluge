void automation.sendInstallmentReminder3DaysOverdue(int crmid)
{
// ZP-TBD-77 -- Rule C: Due_Date + 3 days (first overdue reminder, starts the 10-day chain)
// Thin wrapper: a workflow can't reuse one function with different parameters, so each rule gets its own wrapper
// with the stage fixed here. All logic is in standalone.sendInstallmentReminder.
standalone.sendInstallmentReminder(crmid,"OVERDUE");
}
