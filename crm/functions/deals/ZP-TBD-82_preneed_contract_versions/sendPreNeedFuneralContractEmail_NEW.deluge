string standalone.sendPreNeedFuneralContractEmail(String crmid)
{
// ZP-TBD-82: body moved here from button.sendPreNeedFuneralContract (live copy 2026-09-29) so the
// automatic send (autoSendPreNeedContract) can reuse it. Zoho Sign emails the contract to the buyer.
// Changes vs the live button: the template (Full / One Page) comes from standalone.getPreNeedContractType,
// the Sign Documents record name says which version was sent, the Deal's <version>_Sent_At is stamped,
// and it always returns a JSON string (status, message, contract_type, request_id).
result = Map();
result.put("status","error");
result.put("message","");
result.put("contract_type","");
result.put("request_id","");
recordInfo = zoho.crm.getRecordById("Deals",crmid);
contactId = "";
contactName = "";
try
{
	contactId = ifnull(recordInfo.get("Contact_Name").get("id"),"");
	contactName = ifnull(recordInfo.get("Contact_Name").get("name"),"");
}
catch (eCon)
{
	result.put("message","No NOK Contact linked to this Deal");
	return result.toString();
}
if(contactId == "")
{
	result.put("message","No NOK Contact linked to this Deal");
	return result.toString();
}
accountId = "";
try
{
	accountId = ifnull(recordInfo.get("Account_Name").get("id"),"");
}
catch (eAcc)
{
	result.put("message","No Account linked to this Deal");
	return result.toString();
}
if(accountId == "")
{
	result.put("message","No Account linked to this Deal");
	return result.toString();
}
contactInfo = zoho.crm.getRecordById("Contacts",contactId.toLong());
email = ifnull(contactInfo.get("Email"),"");
if(email == "" || isNull(email))
{
	result.put("message","Email is not available.");
	return result.toString();
}
accountInfo = zoho.crm.getRecordById("Accounts",accountId.toLong());
// ZP-TBD-82: Full or One Page, depending on what has been paid
contractTypeInfo = standalone.getPreNeedContractType(crmid).toMap();
templateId = ifnull(contractTypeInfo.get("template_id"),"");
contractType = ifnull(contractTypeInfo.get("contract_type"),"");
if(templateId == "")
{
	result.put("message",contractTypeInfo.get("message"));
	return result.toString();
}
result.put("contract_type",contractType);
// Pre-fill fields -- keys match the Zoho Sign template's field LABELS exactly.
// If the labels are ever renamed in the Sign editor (e.g. Text - 5 -> Buyer_Name), rename the keys here too.
field_text_data = Map();
// --- Confirmed mappings ---
field_text_data.put("Text - 1",zoho.currenttime.toString("dd"));
field_text_data.put("Text - 35",zoho.currenttime.toString("dd"));
field_text_data.put("Text - 30",zoho.currenttime.toString("dd"));
field_text_data.put("Text - 31",zoho.currenttime.toString("MMM, yyyy"));
field_text_data.put("Text - 36",zoho.currenttime.toString("MMM, yyyy"));
field_text_data.put("Text - 2",zoho.currenttime.toString("MMM"));
field_text_data.put("Text - 3",zoho.currenttime.toString("yyyy"));
field_text_data.put("Text - 5",contactName);
field_text_data.put("Text - 33",contactName);
field_text_data.put("Text - 37",contactName);
field_text_data.put("Text - 6",ifnull(contactInfo.get("Mailing_Street"),"") + ", " + ifnull(contactInfo.get("Mailing_City"),""));
field_text_data.put("Text - 20",ifnull(contactInfo.get("Mailing_Street"),"") + ", " + ifnull(contactInfo.get("Mailing_City"),""));
field_text_data.put("Text - 7",ifnull(contactInfo.get("TRN"),""));
field_text_data.put("Text - 21",ifnull(contactInfo.get("Mobile"),""));
field_text_data.put("Text - 27",ifnull(accountInfo.get("Phone"),""));
field_text_data.put("Text - 23",ifnull(contactInfo.get("Email"),""));
field_text_data.put("Text - 29",ifnull(recordInfo.get("Contract_Value").round(2),""));
// Pre_Need_Contract_Description is rich text (HTML) -- Sign text fields are plain text, so convert first
nl = zoho.encryption.urlDecode("%0A");
descText = ifnull(recordInfo.get("Pre_Need_Contract_Description"),"").toString();
descText = descText.replaceAll("(?i)<br[^>]*>",nl);
descText = descText.replaceAll("(?i)</(p|div|li|h[1-6])>",nl);
descText = descText.replaceAll("(?i)<li[^>]*>","- ");
descText = descText.replaceAll("<[^>]*>","");
descText = descText.replaceAll("&nbsp;"," ");
descText = descText.replaceAll("&lt;","<");
descText = descText.replaceAll("&gt;",">");
descText = descText.replaceAll("&quot;","\"");
descText = descText.replaceAll("&#39;","'");
descText = descText.replaceAll("&amp;","&");
descText = descText.trim();
field_text_data.put("Text - 28",descText);
field_text_data.put("Text - 25",ifnull(accountInfo.get("Billing_Street"),"") + ", " + ifnull(accountInfo.get("Billing_City"),""));
try
{
	field_text_data.put("Text - 24",ifnull(recordInfo.get("Account_Name").get("name"),""));
	field_text_data.put("Text - 26",ifnull(accountInfo.get("Date_of_Birth").toString("dd-MMM-yyyy"),""));
}
catch (e)
{
	info e;
}
casketPrice = ifnull(recordInfo.get("Casket_Price"),0);
field_text_data.put("Text - 8",casketPrice.round(2).toString());
totalAmt = ifnull(recordInfo.get("Contract_Value"),0);
if(totalAmt > 0)
{
	// Text - 18 : "total cost of the funeral goods and services is $"
	field_text_data.put("Text - 18",totalAmt.round(2).toString());
	// Text - 16 : "Or in Full ___ $"
	field_text_data.put("Text - 16",totalAmt.round(2).toString());
}
inst1Amt = ifnull(recordInfo.get("Installment_1_Amount"),0);
if(inst1Amt > 0)
{
	// Text - 11 : "Installments in the amount of ___"
	field_text_data.put("Text - 11",inst1Amt.round(2).toString());
}
inst1Due = ifnull(recordInfo.get("Installment_1_Due_Date"),"");
if(inst1Due != "")
{
	commenceDate = inst1Due.toString().toDate();
	// Text - 12 : "commencing on the ___ day of"   /   Text - 13 : "day of ___"
	field_text_data.put("Text - 12",commenceDate.toString("dd"));
	field_text_data.put("Text - 13",commenceDate.toString("MMMM yyyy"));
}
depositAmt = ifnull(recordInfo.get("Pre_Need_Deposit_Amount"),0);
if(depositAmt > 0)
{
	// Text - 10 : "Deposit of ___"
	field_text_data.put("Text - 10",depositAmt.round(2).toString());
}
balDue = ifnull(recordInfo.get("Pre_Need_Balance_Due_Date"),"");
if(balDue != "")
{
	balanceDate = balDue.toString().toDate();
	// Text - 14 : "Balance on or before the ___ day of"   /   Text - 15 : "day of ___"
	field_text_data.put("Text - 14",balanceDate.toString("dd"));
	field_text_data.put("Text - 15",balanceDate.toString("MMMM yyyy"));
}
field_data = Map();
field_data.put("field_text_data",field_text_data);
// Read the signer action id + role from the template itself (avoids hardcoding ids)
tplResp = invokeurl
[
	url :"https://sign.zoho.com/api/v1/templates/" + templateId
	type :GET
	connection:"zohooauth"
];
tplActionId = "";
tplRole = "";
try
{
	tplActionId = tplResp.get("templates").get("actions").get(0).get("action_id");
	tplRole = tplResp.get("templates").get("actions").get(0).get("role");
}
catch (eTpl)
{
	result.put("message","Could not read signer action from template: " + tplResp.toString());
	return result.toString();
}
eachActionMap1 = Map();
eachActionMap1.put("recipient_name",contactName);
eachActionMap1.put("recipient_email",email);
eachActionMap1.put("action_type","SIGN");
eachActionMap1.put("action_id",tplActionId);
eachActionMap1.put("role",tplRole);
eachActionMap1.put("verify_recipient","false");
fieldList = List();
fieldList.add(eachActionMap1);
redirect_pages = Map();
redirect_pages.put("sign_success","https://dfhda.zohocreatorportal.com");
redirect_pages.put("sign_completed","https://dfhda.zohocreatorportal.com");
actionMap = Map();
actionMap.put("actions",fieldList);
actionMap.put("field_data",field_data);
actionMap.put("redirect_pages",redirect_pages);
submitMap = Map();
submitMap.put("templates",actionMap);
parameters = Map();
parameters.put("is_quicksend","true");
parameters.put("data",submitMap);
signResp = zoho.sign.createUsingTemplate(templateId,parameters);
info "signResp";
info signResp;
request_id = "";
try
{
	request_id = signResp.get("requests").get("request_id");
}
catch (eParse)
{
	result.put("message","Could not parse sign response: " + signResp);
	info result;
	return result.toString();
}
result.put("request_id",request_id);
// Create ZohoSign Documents record in CRM (so the contract shows in the Deal's Sign related list)
try
{
	recordmap = Map();
	recordmap.put("Name","Pre-Need Funeral Contract - " + contractType);
	recordmap.put("zohosign__Account",accountId.toLong());
	recordmap.put("zohosign__Deal",crmid);
	recordmap.put("zohosign__Owner",recordInfo.get("Owner").get("id"));
	recordmap.put("zohosign__Date_Sent",today);
	recordmap.put("Email",email);
	recordmap.put("zohosign__Contact",contactId.toLong());
	recordmap.put("zohosign__ZohoSign_Document_ID",request_id);
	recordmap.put("zohosign__Module_Record_ID",crmid.toString());
	recordmap.put("zohosign__Document_Status","Out for Signature");
	recordmap.put("Request_ID",request_id);
	zoho.crm.createRecord("zohosign__ZohoSign_Documents",recordmap);
}
catch (eDoc)
{
}
// ZP-TBD-82: remember that this version went out, so the automatic send doesn't send it again
stampMap = Map();
if(contractType == "Full")
{
	stampMap.put("Full_Contract_Sent_At",zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ss","America/Jamaica"));
}
else
{
	stampMap.put("One_Page_Contract_Sent_At",zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ss","America/Jamaica"));
}
zoho.crm.updateRecord("Deals",crmid.toLong(),stampMap);
result.put("status","success");
result.put("message",contractType + " contract is sent to Buyer/Beneficiary.");
return result.toString();
}
