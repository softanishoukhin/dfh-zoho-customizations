// ROLLBACK to PRE-FIX-#1 state: replace the entire NOK-contact block in
// onDeceasedPickupCreate.deluge (from "nokId = "";" through the
// NOK_Contact write-back) with this original version. This restores the
// original (broken) behavior: Hospital never links a Contact at all;
// Police tries to read a NOK_Contact lookup that's never populated.

dealDataMap = Map();
tripLk = Map();
tripLk.put("id",tripId);
nokId = "";
if(isHospital)
{
	// ... (unchanged Hospital dealDataMap fields, no NOK Contact_Name link)
}
else if(isPolice)
{
	// ... (unchanged Police dealDataMap fields up to here)
	// NOK from child record (if already set)
	try
	{
		nokId = ifnull(dp.get("NOK_Contact").get("id"),"");
	}
	catch (e)
	{
		nokId = "";
	}
	if(nokId != "")
	{
		ct = Map();
		ct.put("id",nokId);
		dealDataMap.put("Contact_Name",ct);
	}
}

