string standalone.createInstallmentInvoice(Int crmid, String installmentAmountFieldAPI, String installmentDueDateFieldAPI)
{
getRecordInfo = invokeurl
[
	url :"https://www.zohoapis.com/crm/v2.1/Deals/" + crmid
	type :GET
	connection:"zohooauth"
];
recordInfo = getRecordInfo.get("data").get(0);
// ZP-TBD-75: an unused installment slot is left blank by calculateInstallmentAmount -- skip it
// instead of creating a $0 / blank-due-date invoice. This function previously had no such guard,
// which was safe only because Total_Installments was always fixed at 3 (every slot was always
// populated); that's no longer guaranteed now the schedule is date-derived and some Deals will
// only use 1 or 2 of the 3 slots.
guardAmount = ifnull(recordInfo.get(installmentAmountFieldAPI),0);
guardDueDate = recordInfo.get(installmentDueDateFieldAPI);
if(guardAmount <= 0 || isNull(guardDueDate))
{
	info "No amount/due date on " + installmentAmountFieldAPI + " for Deal " + crmid + " - installment invoice not created";
	return "";
}
taxFieldResponse = invokeurl
[
	url :"https://www.zohoapis.com/crm/v8/settings/fields/6503357000000002797?module=Products"
	type :GET
	connection:"zohooauth"
];
taxFieldMap = Map();
fieldsList = taxFieldResponse.get("fields");
if(fieldsList != null && fieldsList.size() > 0)
{
	pickListValues = fieldsList.get(0).get("pick_list_values");
	for each  pickVal in pickListValues
	{
		actualValue = pickVal.get("actual_value");
		valParts = actualValue.toList(" - ");
		taxName = valParts.get(0);
		pctPart = valParts.get(1).replaceAll(" %","").trim();
		pctNum = pctPart.toDecimal();
		entry = Map();
		entry.put("id",pickVal.get("id"));
		entry.put("percentage",pctNum);
		entry.put("name",taxName);
		taxFieldMap.put(actualValue,entry);
	}
}
salesOrders = standalone.COQLQuery("select Subject from Sales_Orders where Deal_Name = '" + crmid + "' and Sales_Order_Type = 'Pre-Need' limit 1");
try
{
	salesOrderID = salesOrders.toList().get(0).get("id");
}
catch (e)
{
	salesOrderID = null;
}
if(installmentAmountFieldAPI == "Installment_1_Amount")
{
	invoiceFor = "Installment 1";
}
else if(installmentAmountFieldAPI == "Installment_2_Amount")
{
	invoiceFor = "Installment 2";
}
else
{
	invoiceFor = "Installment 3";
}
existingInvoiceList = standalone.COQLQuery("select Subject from Invoices where Deal_Name__s = '" + crmid + "' and Invoice_For = '" + invoiceFor + "' limit 1");
// ZP-TBD-95: never rewrite an invoice that has a payment against it (paid or part-paid) -- the money already
// taken is locked. A payment shows on the invoice itself: an Invoice_Payers row (that is what
// createPaymentsOnBooksForRetainerInvoice posts to Books) or a paid amount. Status is NOT used: Books mirrors the
// master retainer's status onto one CRM invoice only (the one in cf_crm_invoice_id), not the one that was paid.
// The subform only comes back on a REST GET, not COQL / getRecordById.
if(existingInvoiceList.size() > 0)
{
	paidCheckDetails = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/Invoices/" + existingInvoiceList.toList().get(0).get("id")
		type :GET
		connection:"zohooauth"
	];
	paidCheckRecord = paidCheckDetails.get("data").get(0);
	invoiceHasPayment = false;
	if(ifnull(paidCheckRecord.get("Total_Actual_Paid_Amount"),0).toString().toDecimal() > 0 || ifnull(paidCheckRecord.get("Payment_Made"),0).toString().toDecimal() > 0)
	{
		invoiceHasPayment = true;
	}
	paidCheckPayers = ifnull(paidCheckRecord.get("Invoice_Payers"),list());
	for each  paidCheckPayer in paidCheckPayers
	{
		if(!isNull(paidCheckPayer.get("Books_Payment_ID")) || ifnull(paidCheckPayer.get("Amount_Paid"),0).toString().toDecimal() > 0)
		{
			invoiceHasPayment = true;
		}
	}
	if(invoiceHasPayment)
	{
		info invoiceFor + " invoice on Deal " + crmid + " has a payment against it - left unchanged";
		return "";
	}
}
invoiceMap = Map();
invoiceMap.put("Sales_Order",salesOrderID);
invoiceMap.put("Owner",recordInfo.get("Owner").get("id"));
invoiceMap.put("Invoice_For",invoiceFor);
if(!isNull(recordInfo.get("Account_Name")))
{
	invoiceMap.put("Account_Name",recordInfo.get("Account_Name").get("id"));
}
if(!isNull(recordInfo.get("Contact_Name")))
{
	invoiceMap.put("Contact_Name",recordInfo.get("Contact_Name").get("id"));
	contactInfo = zoho.crm.getRecordById("Contacts",recordInfo.get("Contact_Name").get("id"));
	invoiceMap.put("Billing_City",ifnull(contactInfo.get("Mailing_City"),""));
	invoiceMap.put("Billing_Code",ifnull(contactInfo.get("Mailing_Zip"),""));
	invoiceMap.put("Billing_Country",ifnull(contactInfo.get("Mailing_Country"),""));
	invoiceMap.put("Billing_State",ifnull(contactInfo.get("Mailing_State"),""));
	invoiceMap.put("Billing_Street",ifnull(contactInfo.get("Mailing_Street"),""));
}
if(existingInvoiceList.size() == 0)
{
	invoiceMap.put("Deal_Name__s",crmid);
	invoiceMap.put("Invoice_Date",zoho.currentdate.toString("yyyy-MM-dd"));
	invoiceMap.put("Status","Created");
	invoiceMap.put("Subject","Invoice  - " + ifnull(recordInfo.get("Deal_Name"),"") + " - " + invoiceFor);
}
invoiceMap.put("Due_Date",recordInfo.get(installmentDueDateFieldAPI));
total_amount = recordInfo.get(installmentAmountFieldAPI).toDecimal();
// ZP-TBD-87: the installment is a share of Contract_Value, which already INCLUDES tax (GCT). It used to be split
// equally over the rows with the product's tax added on top -> the invoice came out higher than the installment.
// Now each row gets the installment's share of its tax-INCLUSIVE total, and the tax is taken back out of it:
// List_Price x Qty - Discount + Tax = the row's share, so the invoice total = the installment.
// The lines are worked out once here and used by both the create and the update branch below.
rowInfoList = list();
dealGrossTotal = 0.0;
for each  row in recordInfo.get("Product_Selection")
{
	rowQuantity = row.get("Quantity");
	if(isNull(rowQuantity) || rowQuantity == 0)
	{
		rowQuantity = 1;
	}
	rowDiscount = ifnull(row.get("Discount"),0);
	rowNet = rowQuantity * ifnull(row.get("Unit_Price"),0) - rowDiscount;
	rowTaxInfo = null;
	rowTaxPct = 0.0;
	rowProduct = zoho.crm.getRecordById("Products",row.get("Child_Product").get("id"));
	rowTaxList = rowProduct.get("Tax");
	if(rowTaxList != null && rowTaxList.size() > 0)
	{
		rowTaxInfo = taxFieldMap.get(rowTaxList.get(0));
		if(rowTaxInfo != null)
		{
			rowTaxPct = rowTaxInfo.get("percentage").toDecimal();
		}
	}
	rowGross = rowNet * (1 + rowTaxPct / 100);
	dealGrossTotal = dealGrossTotal + rowGross;
	rowInfo = Map();
	rowInfo.put("row",row);
	rowInfo.put("quantity",rowQuantity);
	rowInfo.put("discount",rowDiscount);
	rowInfo.put("gross",rowGross);
	rowInfo.put("taxInfo",rowTaxInfo);
	rowInfo.put("taxPct",rowTaxPct);
	rowInfoList.add(rowInfo);
}
if(dealGrossTotal <= 0)
{
	info "Product total is 0 on Deal " + crmid + " - installment invoice not created";
	return "";
}
shareFraction = total_amount / dealGrossTotal;
rowCount = rowInfoList.size();
sumGross = 0.0;
rowIndex = 0;
planLines = list();
for each  rowInfo in rowInfoList
{
	rowIndex = rowIndex + 1;
	product = rowInfo.get("row");
	lineQuantity = rowInfo.get("quantity");
	lineTaxPct = rowInfo.get("taxPct");
	// the last row takes the rounding cents, so the lines add up to the installment
	if(rowIndex < rowCount)
	{
		lineGross = (rowInfo.get("gross") * shareFraction).round(2);
		sumGross = sumGross + lineGross;
	}
	else
	{
		lineGross = total_amount - sumGross;
	}
	lineNet = lineGross / (1 + lineTaxPct / 100);
	lineDiscount = (rowInfo.get("discount") * shareFraction).round(2);
	lineListPrice = ((lineNet + lineDiscount) / lineQuantity).round(2);
	productMap = Map();
	if(!isNull(product.get("Parent_Product")))
	{
		productMap.put("Parent_Product",product.get("Parent_Product").get("id"));
	}
	productMap.put("Product_Name",product.get("Child_Product").get("id"));
	productMap.put("Quantity",lineQuantity);
	productMap.put("List_Price",lineListPrice);
	productMap.put("Discount",lineDiscount);
	// tax is charged on the line AFTER its discount
	lineTaxInfo = rowInfo.get("taxInfo");
	if(lineTaxInfo != null)
	{
		lineTaxValue = ((lineQuantity * lineListPrice - lineDiscount) * lineTaxPct / 100).round(2);
		taxEntry = Map();
		taxEntry.put("id",lineTaxInfo.get("id"));
		taxEntry.put("name",lineTaxInfo.get("name"));
		taxEntry.put("percentage",lineTaxPct);
		taxEntry.put("value",lineTaxValue);
		productMap.put("Line_Tax",{taxEntry});
		productMap.put("Tax",lineTaxValue);
	}
	else
	{
		productMap.put("Line_Tax",list());
		productMap.put("Tax",0);
	}
	planLines.add(productMap);
}
if(existingInvoiceList.size() == 0)
{
	invoiceMap.put("Invoiced_Items",planLines);
	invoiceMap.put("Retainer_Invoice",true);
	recordList = list();
	recordList.add(invoiceMap);
	dataMap = Map();
	dataMap.put("data",recordList);
	info dataMap;
	createInvoice = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/Invoices"
		type :POST
		parameters:dataMap.toString()
		connection:"zohooauth"
	];
	if(!isNull(recordInfo.get("Account_Name")))
	{
		accountID = recordInfo.get("Account_Name").get("id");
		relatedContacts = zoho.crm.getRelatedRecords("Contacts","Accounts",accountID);
		for each  contact in relatedContacts
		{
			potentialPayers = Map();
			potentialPayers.put("Name",ifnull(contact.get("First_Name"),"") + " " + contact.get("Last_Name"));
			potentialPayers.put("Account",accountID);
			potentialPayers.put("Invoice",createInvoice.get("data").get(0).get("details").get("id"));
			potentialPayers.put("Contact",contact.get("id"));
			createPotentialPayerResult = zoho.crm.createRecord("Potential_Payers",potentialPayers);
		}
	}
}
else
{
	// Existing invoice: line N is rewritten with plan line N (keeping its id), lines beyond the Deal's rows are
	// deleted, and rows beyond the existing lines are added.
	lineItemList = list();
	existingInvoiceDetails = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/Invoices/" + existingInvoiceList.toList().get(0).get("id")
		type :GET
		connection:"zohooauth"
	];
	crmInvoiceRecordData = existingInvoiceDetails.get("data").get(0);
	crmInvoicedExistingItems = crmInvoiceRecordData.get("Invoiced_Items");
	index = 0;
	for each  crmInvoiceItem in crmInvoicedExistingItems
	{
		if(index < planLines.size())
		{
			itemMap = planLines.get(index);
			itemMap.put("id",crmInvoiceItem.get("id"));
			lineItemList.add(itemMap);
		}
		else
		{
			itemMap = Map();
			itemMap.put("_delete","null");
			itemMap.put("id",crmInvoiceItem.get("id"));
			lineItemList.add(itemMap);
		}
		index = index + 1;
	}
	reLoopIndex = 0;
	for each  planLine in planLines
	{
		if(reLoopIndex >= index)
		{
			lineItemList.add(planLine);
		}
		reLoopIndex = reLoopIndex + 1;
	}
	invoiceMap.put("Invoiced_Items",lineItemList);
	recordList = list();
	recordList.add(invoiceMap);
	dataMap = Map();
	dataMap.put("data",recordList);
	createInvoice = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/Invoices/" + existingInvoiceList.toList().get(0).get("id")
		type :PUT
		parameters:dataMap.toString()
		connection:"zohooauth"
	];
}
api_names = installmentAmountFieldAPI.toList("_");
api_name = api_names.get(1);
info standalone.save_api_responses("Create_Installment_Invoice_" + api_name,"Deals",crmid,createInvoice.toString());
return "";
}
