
try
{
	getUrl("https://www.zohoapis.com/creator/custom/delapenhafuneralhome/Sleep_API?publickey=69fNOfX03TwjyaAgAYyRTJSBd&seconds=20");
}
catch (e)
{
	info e;
}
PRE_NEED_DIFFERENCE_ITEM_ID = "5830143000035961673";
retainerInvoiceID = retainer_invoice.get("retainerinvoice_id");
organizationID = organization.get("organization_id");
retainerFullResponse = zoho.books.getRecordsByID("RetainerInvoices",organizationID,retainerInvoiceID,"zohobooksconnection");
retainerData = retainerFullResponse.get("retainerinvoice");
appliedInvoices = retainerFullResponse.get("invoices");
if(isNull(appliedInvoices) || appliedInvoices.size() == 0)
{
	info "Not applied to any invoice yet -- nothing to do.";
	return;
}
// Build a lookup of the retainer's own original per-product amounts, keyed
// by normalized product name -- reused for every applied invoice below.
originalPriceByProductName = Map();
for each  retainerLine in retainerData.get("line_items")
{
	productName = retainerLine.get("description");
	if(!isNull(productName) && productName.trim() != "")
	{
		normalizedName = productName.trim().toLowerCase();
		existingAmount = originalPriceByProductName.get(normalizedName);
		if(isNull(existingAmount))
		{
			existingAmount = 0;
		}
		originalPriceByProductName.put(normalizedName,existingAmount + retainerLine.get("item_total"));
	}
}
for each  appliedInvoiceEntry in appliedInvoices
{
	invoiceID = appliedInvoiceEntry.get("invoice_id");
	amountApplied = appliedInvoiceEntry.get("amount_applied");
	if(isNull(amountApplied))
	{
		amountApplied = appliedInvoiceEntry.get("total_applied_retainer_amount");
	}
	if(isNull(invoiceID) || invoiceID == "")
	{
		continue;
	}
	invoiceDetails = zoho.books.getRecordsByID("Invoices",organizationID,invoiceID,"zohobooksconnection");
	invoiceData = invoiceDetails.get("invoice");
	// ==========================================
	// COMPUTE THE PRE-NEED DIFFERENCE LINE, IF NEEDED (idempotent per invoice)
	// ==========================================
	alreadyHasDifferenceLine = false;
	for each  existingLine in invoiceData.get("line_items")
	{
		if(existingLine.get("item_id") == PRE_NEED_DIFFERENCE_ITEM_ID)
		{
			alreadyHasDifferenceLine = true;
		}
	}
	needsDifferenceLine = false;
	differenceLineAmount = 0;
	if(alreadyHasDifferenceLine == false)
	{
		todaysPriceForContractItems = 0;
		originalPriceForMatchedItems = 0;
		for each  atNeedLine in invoiceData.get("line_items")
		{
			productName = atNeedLine.get("name");
			if(isNull(productName) || productName.trim() == "")
			{
				productName = atNeedLine.get("description");
			}
			if(!isNull(productName) && productName.trim() != "")
			{
				normalizedName = productName.trim().toLowerCase();
				if(originalPriceByProductName.containKey(normalizedName))
				{
					todaysPriceForContractItems = todaysPriceForContractItems + atNeedLine.get("item_total");
					originalPriceForMatchedItems = originalPriceForMatchedItems + originalPriceByProductName.get(normalizedName);
				}
			}
		}
		gap = todaysPriceForContractItems - originalPriceForMatchedItems;
		if(gap > 0)
		{
			needsDifferenceLine = true;
			differenceLineAmount = gap;
		}
		else if(gap < 0)
		{
			// Contract price >= today's matching-item price -- the
			// overpayment/refund case, explicitly out of scope for this
			// ticket (confirmed with Andrea). Flag for manual handling.
			sendmail
			[
				from :zoho.adminuserid
				to :"softanis.noushadurrahman@gmail.com"
				subject :"Pre-Need: possible family credit owed"
				message :"Invoice " + invoiceData.get("invoice_number") + " has a pre-need contract price higher than today's matching product total by " + abs(gap) + ". This case (family may be owed a refund/credit) is out of scope for ZP-TBD-65 and needs manual handling."
			]
		}
	}
	// ==========================================
	// SINGLE UPDATE -- difference line (if needed) + handoff fields together
	// ==========================================
	// Combined into one updateRecord call so this function re-triggers
	// createinvoiceonxero at most once per applied invoice, instead of twice.
	combinedUpdateMap = Map();
	if(needsDifferenceLine == true)
	{
		newLineItemsList = list();
		for each  existingLine in invoiceData.get("line_items")
		{
			newLineItemsList.add(existingLine);
		}
		differenceLine = Map();
		differenceLine.put("item_id",PRE_NEED_DIFFERENCE_ITEM_ID);
		differenceLine.put("quantity",1);
		differenceLine.put("rate",differenceLineAmount * -1);
		differenceLine.put("description","Pre-Need Difference - retainer " + retainerData.get("retainerinvoice_number"));
		newLineItemsList.add(differenceLine);
		combinedUpdateMap.put("line_items",newLineItemsList);
	}
	handoffFields = list();
	handoffFields.add({"api_name":"cf_pre_need_retainer_applied_amount","value":amountApplied});
	handoffFields.add({"api_name":"cf_pre_need_retainer_number","value":retainerData.get("retainerinvoice_number")});
	combinedUpdateMap.put("custom_fields",handoffFields);
	combinedUpdateMap.put("reason","Adjust from retainer invoice.");
	result = zoho.books.updateRecord("Invoices",organizationID,invoiceID,combinedUpdateMap,"zohobooksconnection");
	info result;
	info "result";
	if(needsDifferenceLine == true)
	{
		info "Added Pre-Need Difference line of " + differenceLineAmount * -1 + " to invoice " + invoiceData.get("invoice_number");
	}
	info "Flagged invoice " + invoiceData.get("invoice_number") + " for pre-need retainer credit note (amount " + amountApplied + ")";
}
