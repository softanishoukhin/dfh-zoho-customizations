string standalone.markQuotePromptShown(Int crmid)
{
	existingID = "";
	try
	{
		sdResp = standalone.COQLQuery("select id from System_Data where (Module_Name = 'Deals' and Module_ID = '" + crmid + "') and Name = 'Quote_Prompt_Shown' limit 1");
		if(sdResp.size() > 0)
		{
			sdList = sdResp.toList();
			existingID = sdList.get(0).get("id");
		}
	}
	catch (e)
	{
		existingID = "";
	}
	sdMap = Map();
	sdMap.put("Name","Quote_Prompt_Shown");
	sdMap.put("Module_Name","Deals");
	sdMap.put("Module_ID",crmid.toString());
	sdMap.put("System_Info","true");
	try
	{
		if(existingID != "")
		{
			result = zoho.crm.updateRecord("System_Data",existingID.toLong(),sdMap);
		}
		else
		{
			result = zoho.crm.createRecord("System_Data",sdMap);
		}
		info result;
	}
	catch (e)
	{
		return "error: " + e.toString();
	}
	return "ok";
}
